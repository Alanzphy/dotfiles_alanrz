{{- /* Regenerate local config; keep whatever data the templates need.
       Key strategy: prefer env var, else prompt, else state (promptOnce). */ -}}
sourceDir = {{ joinPath .chezmoi.homeDir "Projects/dotfiles_alanrz" | quote }}

{{- $aiKey := "" }}
{{- if stdinIsATTY }}
{{-   $aiKey = promptStringOnce . "aiUsagebarApiKey" "API key para ai-usagebar (enter para saltar)" (env "OPENCODE_GO_API_KEY") }}
{{- else }}
{{-   $aiKey = env "OPENCODE_GO_API_KEY" }}
{{- end }}

[data]
    os = {{ .chezmoi.os | quote }}
    hostname = {{ .chezmoi.hostname | quote }}

[data.aiUsagebar]
    apiKey = {{ $aiKey | quote }}

[diff]
    exclude = ["scripts"]
