# Environment, aliases, and personal functions
[[ -f ~/.zsh/env.zsh ]]        && source ~/.zsh/env.zsh
[[ -f ~/.zsh/starship.zsh ]]   && source ~/.zsh/starship.zsh
[[ -f ~/.zsh/venvchecker.zsh ]] && source ~/.zsh/venvchecker.zsh
[[ -f ~/.zsh/functions.zsh ]]  && source ~/.zsh/functions.zsh

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_DISABLE_COMPFIX=true

# Completions installed by packages and local tools.
fpath=(~/.zsh/completions /usr/share/zsh/site-functions $fpath)
typeset -U fpath

plugins=(
  sudo
  fzf
  zoxide
  ssh
  zsh-autosuggestions
  # zsh-syntax-highlighting
  F-Sy-H
  fzf-tab
)

source "$ZSH/oh-my-zsh.sh"

# Personal aliases override Oh My Zsh defaults.
[[ -f ~/.zsh/aliases.zsh ]] && source ~/.zsh/aliases.zsh

# Keybindings
bindkey -e
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[w' kill-region

# History
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'
zstyle ':completion:*:*:docker:*' option-stacking yes
zstyle ':completion:*:*:docker-*:*' option-stacking yes

# Interactive tools
eval "$(starship init zsh)"
eval "$(thefuck --alias)"
eval "$(zoxide init --cmd cd zsh)"

# Edit the current command line in the configured editor.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^x^e' edit-command-line
