[ui]
primary = "supergrok"

[supergrok]
enabled = true

[opencode-go]
enabled = true
api_key_env = "OPENCODE_GO_API_KEY"
# api_key = "sk-..."  # inline fallback; NOT committed here — set via env var

# Keep their credentials/configuration, but hide these providers from the UI.
[zai]
enabled = false

[openrouter]
enabled = false
api_key_env = "OPENROUTER_API_KEY"
# api_key = "sk-..."  # inline fallback; NOT committed here

[commandcode]
enabled = false
